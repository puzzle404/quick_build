# Environment variables loaded via dotenv-rails in development and test

# Show real browser for system specs using JS (Cuprite)
# Set to 1 to open a visible Chromium window during tests
HEADFUL=
SHOW_BROWSER=

OPENAI_API_KEY=your_openai_api_key_here
OPENWEATHER_API_KEY=replace_me_in_local_env

# Google Maps (dirección + mapa de la obra). Key de NAVEGADOR con "Maps
# JavaScript API" y "Places API (New)" habilitadas; restringila por HTTP
# referrer (tu dominio y localhost). Sin key, la dirección se guarda igual como
# texto y el mapa muestra un aviso.
GOOGLE_MAPS_API_KEY=
