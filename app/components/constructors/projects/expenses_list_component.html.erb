<div>
  <% unless bare %>
    <div class="qb-section-title">
      <span>Gastos · <%= expenses.size %></span>
    </div>

    <% if expenses.empty? %>
      <div class="qb-empty">
        Todavía no se registraron gastos.
      </div>
    <% end %>
  <% end %>

  <% if expenses.any? %>
    <% if bare %>
      <div class="sd-list">
        <% expenses.each do |expense| %>
          <div class="sd-list-row">
            <div class="sd-list-main">
              <div class="sd-list-title"><%= expense.description.presence || "Sin descripción" %></div>
              <div class="sd-list-meta">
                <%= helpers.qb_fmt_date_short(expense.incurred_on) %> · <%= category_label(expense) %>
                <% if expense.receipt.attached? %>
                  · <%= link_to 'Comprobante', receipt_path(expense), data: { turbo: false }, target: '_blank', rel: 'noopener', style: 'color:var(--color-accent);text-decoration:none;' %>
                <% end %>
              </div>
            </div>
            <div class="sd-list-side">
              <span class="sd-list-value"><%= helpers.qb_fmt_cents(expense.amount_cents) %></span>
              <% if can_destroy?(expense) %>
                <%= render Qb::BtnComponent.new('Eliminar', variant: :danger, size: :xs,
                      href: delete_path(expense),
                      data: { turbo_method: :delete, turbo_confirm: '¿Eliminar este gasto?', turbo_frame: '_top' }) %>
              <% end %>
            </div>
          </div>
        <% end %>
        <div class="sd-list-foot">
          <span>Total</span>
          <span class="sd-list-value"><%= helpers.qb_fmt_cents(total_cents) %></span>
        </div>
      </div>
    <% else %>
      <div style="border:1px solid var(--color-line);border-radius:var(--radius);overflow:hidden;">
        <table class="qb-table">
          <thead>
            <tr>
              <th>Fecha</th>
              <th>Categoría</th>
              <th>Descripción</th>
              <% if show_stage %><th>Etapa</th><% end %>
              <th>Comprobante</th>
              <th style="text-align:right;">Monto</th>
              <% if show_actions_column? %><th></th><% end %>
            </tr>
          </thead>
          <tbody>
            <% expenses.each do |expense| %>
              <tr>
                <td style="font-family:var(--font-mono);white-space:nowrap;color:var(--color-ink-2);"><%= helpers.qb_fmt_date_short(expense.incurred_on) %></td>
                <td style="color:var(--color-ink-2);"><%= category_label(expense) %></td>
                <td>
                  <div><%= expense.description.presence || 'Sin descripción' %></div>
                  <% if expense.material_list.present? %>
                    <div style="font-size:11px;color:var(--color-ink-4);margin-top:2px;">
                      Pago de lista
                      <%= link_to "#{expense.material_list.display_number} #{expense.material_list.name}".strip,
                            material_list_path(expense),
                            style: 'color:var(--color-accent);text-decoration:none;' %>
                    </div>
                  <% end %>
                </td>
                <% if show_stage %>
                  <td style="color:var(--color-ink-2);">
                    <% if expense.project_stage.present? %>
                      <%= link_to expense.project_stage.name, stage_path(expense),
                            style: 'color:var(--color-accent);text-decoration:none;' %>
                    <% else %>
                      <span style="color:var(--color-ink-4);">—</span>
                    <% end %>
                  </td>
                <% end %>
                <td>
                  <% if expense.receipt.attached? %>
                    <%= link_to receipt_path(expense), data: { turbo: false }, target: '_blank', rel: 'noopener',
                          style: 'display:inline-flex;align-items:center;gap:5px;color:var(--color-accent);text-decoration:none;' do %>
                      <%= render Qb::IconComponent.new(name: :doc, size: 12) %>
                      Ver
                    <% end %>
                  <% else %>
                    <span style="color:var(--color-ink-4);">—</span>
                  <% end %>
                </td>
                <td style="text-align:right;font-family:var(--font-mono);font-weight:500;" class="qb-tnum"><%= helpers.qb_fmt_cents(expense.amount_cents) %></td>
                <% if show_actions_column? %>
                  <td style="text-align:right;">
                    <% if can_destroy?(expense) %>
                      <%= render Qb::BtnComponent.new('Eliminar', variant: :danger, size: :xs,
                            href: delete_path(expense),
                            data: { turbo_method: :delete, turbo_confirm: '¿Eliminar este gasto?' }) %>
                    <% end %>
                  </td>
                <% end %>
              </tr>
            <% end %>
          </tbody>
          <tfoot>
            <tr style="background:var(--color-bg-sunken);">
              <td colspan="<%= colspan_before_total %>" style="padding:8px 10px;font-size:11px;font-weight:600;color:var(--color-ink);font-family:var(--font-mono);text-transform:uppercase;letter-spacing:0.5px;">Total</td>
              <td style="padding:8px 10px;"></td>
              <td style="padding:8px 10px;text-align:right;font-size:12px;font-weight:600;color:var(--color-ink);font-family:var(--font-mono);" class="qb-tnum"><%= helpers.qb_fmt_cents(total_cents) %></td>
              <% if show_actions_column? %><td style="padding:8px 10px;"></td><% end %>
            </tr>
          </tfoot>
        </table>
      </div>
    <% end %>
  <% end %>
</div>
