<div data-controller="qb--drawer">
  <%= render Qb::SectionHeadComponent.new(
        title: 'Accesos a la obra',
        subtitle: 'Usuarios de QuickBuild que pueden entrar a esta obra, y con qué permisos') do |c| %>
    <% if can_manage? %>
      <% c.with_right do %>
        <%= render Qb::BtnComponent.new('Invitar miembro', variant: :primary, size: :xs, icon: :plus,
              data: { action: 'click->qb--drawer#open' }) %>
      <% end %>
    <% end %>
  <% end %>

  <table style="width:100%;border-collapse:collapse;font-size:12px;">
    <thead>
      <tr style="background:var(--color-bg-raised);">
        <% ['Usuario', 'Rol en la obra', 'Qué puede hacer', ''].each_with_index do |h, i| %>
          <th style="padding:8px 12px;text-align:<%= i == 3 ? 'right' : 'left' %>;border-bottom:1px solid var(--color-line);font-size:10px;font-family:var(--font-mono);color:var(--color-ink-3);font-weight:500;letter-spacing:0.5px;text-transform:uppercase;"><%= h %></th>
        <% end %>
      </tr>
    </thead>
    <tbody>
      <% rows.each do |user, role, membership| %>
        <tr style="height:40px;border-bottom:1px solid var(--color-line);">
          <td style="padding:0 12px;">
            <div style="display:flex;align-items:center;gap:10px;">
              <%= render Qb::AvatarComponent.new(name: display_name(user), size: 26) %>
              <div>
                <div style="font-weight:500;color:var(--color-ink);"><%= display_name(user) %></div>
                <div class="qb-mono" style="font-size:10px;color:var(--color-ink-4);"><%= user.email %></div>
              </div>
            </div>
          </td>
          <td style="padding:0 12px;">
            <%= render Constructors::Projects::RoleBadgeComponent.new(role: role, show_owner: true) %>
          </td>
          <td style="padding:0 12px;color:var(--color-ink-3);"><%= role_hint(role) %></td>
          <td style="padding:0 12px;text-align:right;white-space:nowrap;">
            <% if membership.nil? %>
              <%# El dueño no tiene membresía: no hay nada que quitar. %>
              <span style="font-size:11px;color:var(--color-ink-4);">Dueño de la obra</span>
            <% elsif can_manage? %>
              <%= render Qb::BtnComponent.new('Quitar', variant: :danger, size: :xs, icon: :trash,
                    href: helpers.constructors_project_project_membership_path(project, membership),
                    data: { turbo_method: :delete,
                            turbo_confirm: "¿Quitar a #{user.email} del equipo de la obra? Deja de ver la obra al instante." }) %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <% if can_manage? %>
    <%= render Constructors::Projects::Overview::InviteMemberDrawerComponent.new(project: project) %>
  <% end %>
</div>
