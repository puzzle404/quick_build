<div style="padding:4px 16px 14px;display:flex;flex-direction:column;gap:8px;">
  <% if items.empty? %>
    <div style="padding:14px;text-align:center;color:var(--color-ink-3);font-size:12px;border:1px dashed var(--color-line);border-radius:6px;">Sin alertas: la obra viene en plan.</div>
  <% else %>
    <% shown_items.each do |r| %>
      <div style="padding:10px;border:1px solid var(--color-line);border-radius:6px;background:var(--color-bg-raised);display:flex;gap:10px;">
        <%= render Qb::StatusDotComponent.new(tone: r[:tone]) %>
        <div style="flex:1;min-width:0;">
          <div style="font-size:12.5px;font-weight:600;color:var(--color-ink);"><%= r[:title] %></div>
          <div style="font-size:11.5px;color:var(--color-ink-3);margin-top:2px;"><%= r[:body] %></div>
          <% if r[:cta] && r[:href] %>
            <%= link_to "#{r[:cta]} →", r[:href], data: r[:data] || {},
                  style: "display:inline-block;margin-top:6px;font-size:11.5px;font-weight:500;color:var(--color-accent);text-decoration:none;" %>
          <% end %>
        </div>
      </div>
    <% end %>
  <% end %>
</div>
