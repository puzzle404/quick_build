<div style="display:flex;flex-direction:column;gap:8px;padding:10px 12px;border:1px solid var(--color-line);border-radius:var(--radius);background:var(--color-bg-raised);"
     data-controller="qb--share"
     data-qb--share-title-value="<%= @project.name %>"
     data-qb--share-text-value="<%= share_text %>">
  <div style="display:flex;align-items:flex-start;gap:6px;min-width:0;">
    <%= render Qb::IconComponent.new(name: :pin, size: 13, style: 'color:var(--color-ink-3);margin-top:2px;flex-shrink:0;') %>
    <span style="font-size:12px;color:<%= address ? 'var(--color-ink)' : 'var(--color-ink-4)' %>;line-height:1.4;"><%= address || 'Sin domicilio cargado' %></span>
  </div>
  <div style="display:flex;align-items:center;gap:6px;flex-wrap:wrap;">
    <%= render Qb::BtnComponent.new('Compartir ubicación', variant: :secondary, size: :xs, icon: :copy,
          data: { action: 'qb--share#share' }) %>
    <%= render Qb::BtnComponent.new('WhatsApp', variant: :ghost, size: :xs, icon: :'external-link',
          href: whatsapp_url, target: '_blank') %>
    <%= render Qb::BtnComponent.new('Google Maps', variant: :ghost, size: :xs, icon: :map,
          href: maps_url, target: '_blank') %>
  </div>
</div>
