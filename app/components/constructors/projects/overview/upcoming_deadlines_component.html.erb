<div style="padding:4px 16px 12px;">
  <% if stages.empty? %>
    <div style="padding:10px 0;font-size:12px;color:var(--color-ink-4);">Sin etapas pendientes con fecha de fin.</div>
  <% else %>
    <% stages.each do |stage| %>
      <% late = overdue?(stage) %>
      <%= link_to constructors_project_stage_path(project, stage),
            data: { turbo_frame: 'drawer', action: 'click->qb--drawer#open' },
            style: 'display:grid;grid-template-columns:26px minmax(0,1fr) auto;gap:10px;align-items:center;padding:9px 0;border-bottom:1px solid var(--color-line);text-decoration:none;color:inherit;' do %>
        <span class="qb-mono" style="font-size:11px;color:var(--color-ink-3);"><%= stage.position %></span>
        <div style="min-width:0;">
          <div style="font-size:12.5px;font-weight:500;color:var(--color-ink);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;"><%= stage.name %></div>
          <div style="margin-top:5px;"><%= render Qb::BarComponent.new(value: stage.progress.to_i, tone: late ? :bad : :accent, height: 3) %></div>
        </div>
        <span class="qb-mono" style="font-size:11px;white-space:nowrap;color:<%= late ? 'var(--color-bad)' : 'var(--color-ink-2)' %>;"><%= due_label(stage) %></span>
      <% end %>
    <% end %>
  <% end %>
</div>
