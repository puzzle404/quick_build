<%= form_with model: person, url: form_url, method: form_method do |form| %>
  <% if person.errors.any? %>
    <div class="qb-form-error" role="alert">
      <p style="font-weight:600;margin:0 0 4px;">No pudimos guardar la persona:</p>
      <ul style="margin:0;padding-left:16px;">
        <% person.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= render Qb::FormGroupComponent.new(title: 'Identidad') do %>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
      <div class="qb-field" style="margin-bottom:0;grid-column:span 2;">
        <%= form.label :full_name, "Nombre y apellido", class: "qb-label" %>
        <%= form.text_field :full_name, class: "qb-input", placeholder: "Ej: Juana Pérez" %>
      </div>
      <div class="qb-field" style="margin-bottom:0;">
        <%= form.label :role_title, "Rol / oficio", class: "qb-label" %>
        <%= form.text_field :role_title, class: "qb-input", placeholder: "Ej: Oficial albañil" %>
      </div>
      <div class="qb-field" style="margin-bottom:0;">
        <%= form.label :document_id, "Documento", class: "qb-label" %>
        <%= form.text_field :document_id, class: "qb-input", placeholder: "DNI / CUIL" %>
      </div>
      <div class="qb-field" style="margin-bottom:0;grid-column:span 2;">
        <%= form.label :phone, "Teléfono", class: "qb-label" %>
        <%= form.text_field :phone, class: "qb-input", placeholder: "Ej: 11 5555 5555" %>
      </div>
    </div>
  <% end %>

  <%# La tarifa está en la tabla desde siempre pero no había forma de cargarla:
      el KPI «Tarifa» de las dos fichas y la columna «$/hora» del listado eran
      guion en el 100% de los registros. %>
  <%= render Qb::FormGroupComponent.new(title: 'Condiciones',
        footnote: 'Tarifa de referencia por hora en esta obra. El costo de mano de obra se calcula sobre las horas registradas.') do %>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
      <div class="qb-field" style="margin-bottom:0;">
        <%= form.label :hourly_rate_pesos, "Tarifa ($/hora)", class: "qb-label" %>
        <div style="position:relative;">
          <span class="qb-mono" style="position:absolute;left:10px;top:50%;transform:translateY(-50%);font-size:12px;color:var(--color-ink-4);">$</span>
          <%= form.text_field :hourly_rate_pesos, value: hourly_rate_pesos_value, class: "qb-input",
                inputmode: "decimal", placeholder: "0", style: "padding-left:22px;" %>
        </div>
      </div>
      <div class="qb-field" style="margin-bottom:0;">
        <%= form.label :status, "Estado", class: "qb-label" %>
        <%= form.select :status, status_options, {}, class: "qb-select" %>
      </div>
    </div>
  <% end %>

  <%= render Qb::FormGroupComponent.new(title: 'Vigencia',
        footnote: 'Dejá el fin vacío mientras la persona siga en la obra.') do %>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
      <div class="qb-field" style="margin-bottom:0;">
        <%= form.label :start_date, "Inicio", class: "qb-label" %>
        <%= form.date_field :start_date, class: "qb-input" %>
      </div>
      <div class="qb-field" style="margin-bottom:0;">
        <%= form.label :end_date, "Fin", class: "qb-label" %>
        <%= form.date_field :end_date, class: "qb-input" %>
      </div>
    </div>
  <% end %>

  <%= render Qb::FormGroupComponent.new(title: 'Notas') do %>
    <div class="qb-field" style="margin-bottom:0;">
      <%= form.label :notes, "Notas", class: "qb-label" %>
      <%= form.text_area :notes, rows: 3, class: "qb-textarea", placeholder: "Acuerdos, jornal, observaciones…" %>
    </div>
  <% end %>

  <div style="display:flex;align-items:center;gap:8px;margin-top:4px;padding-top:14px;border-top:1px solid var(--color-line);">
    <div style="flex:1;"></div>
    <%= render Qb::BtnComponent.new("Cancelar", variant: :secondary, size: :md, data: { action: 'click->qb--drawer#close' }) %>
    <%= render Qb::BtnComponent.new(submit_label, variant: :primary, size: :md, type: 'submit') %>
  </div>
<% end %>
