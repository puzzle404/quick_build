<div class="qb-drawer-shell" role="dialog" aria-modal="true"
     data-qb--drawer-target="dialog"
     data-action="click->qb--drawer#backdrop keydown@window->qb--drawer#keydown">
  <div class="qb-drawer-backdrop"></div>
  <%= render(Qb::DrawerComponent.new(eyebrow: "Planificación", title: "Aplicar plantilla de etapas", subtitle: "Crea las etapas que no existan. Las existentes se mantienen tal cual.", size: :lg)) do %>
    <%= form_with url: apply_template_constructors_project_stages_path(project), method: :post do %>
      <div style="display:flex;flex-direction:column;gap:10px;">

        <%# Plantilla base del sistema — sin id, es la constante del service. %>
        <label style="display:block;border:1px solid var(--color-line);border-radius:8px;padding:12px;background:var(--color-bg-raised);cursor:pointer;">
          <div style="display:flex;align-items:flex-start;gap:10px;">
            <input type="radio" name="stage_template_id" value="" checked style="margin-top:3px;">
            <div style="flex:1;min-width:0;">
              <div style="display:flex;align-items:baseline;gap:8px;">
                <div style="font-weight:600;font-size:13px;color:var(--color-ink);">Plantilla base</div>
                <span class="qb-mono" style="font-size:10px;color:var(--color-ink-4);background:var(--color-bg-sunken);padding:2px 6px;border-radius:3px;">
                  <%= base_stages.size %> etapas · <%= base_sub_stages_count %> sub
                </span>
              </div>
              <div style="font-size:11px;color:var(--color-ink-3);margin-top:2px;">Estructura estándar de obra: proyecto y gestión, dirección de obra y administración.</div>
            </div>
          </div>

          <div style="margin-top:10px;display:flex;flex-direction:column;gap:8px;">
            <% base_stages.each_with_index do |stage, i| %>
              <div>
                <div style="display:flex;align-items:center;gap:8px;">
                  <div style="width:22px;height:22px;border-radius:5px;background:color-mix(in oklab, var(--color-accent) 14%, transparent);color:var(--color-accent);display:flex;align-items:center;justify-content:center;font-family:var(--font-mono);font-weight:600;font-size:11px;">
                    <%= i + 1 %>
                  </div>
                  <div style="font-size:12px;font-weight:500;color:var(--color-ink-2);"><%= stage[:name] %></div>
                </div>
                <div style="display:flex;flex-wrap:wrap;gap:4px;margin:5px 0 0 30px;">
                  <% stage.fetch(:sub_stages, []).each do |sub| %>
                    <span style="font-size:11px;padding:2px 8px;background:var(--color-bg-sunken);border-radius:12px;color:var(--color-ink-3);"><%= sub[:name] %></span>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        </label>

        <%# Plantillas guardadas por el constructor. %>
        <% if saved_templates? %>
          <div class="qb-mono" style="font-size:10px;color:var(--color-ink-4);text-transform:uppercase;letter-spacing:0.6px;margin-top:4px;">Mis plantillas</div>

          <% saved_templates.each do |template| %>
            <label style="display:block;border:1px solid var(--color-line);border-radius:8px;padding:12px;background:var(--color-bg-raised);cursor:pointer;">
              <div style="display:flex;align-items:flex-start;gap:10px;">
                <input type="radio" name="stage_template_id" value="<%= template.id %>" style="margin-top:3px;">
                <div style="flex:1;min-width:0;">
                  <div style="display:flex;align-items:baseline;gap:8px;flex-wrap:wrap;">
                    <div style="font-weight:600;font-size:13px;color:var(--color-ink);"><%= template.name %></div>
                    <span class="qb-mono" style="font-size:10px;color:var(--color-ink-4);background:var(--color-bg-sunken);padding:2px 6px;border-radius:3px;"><%= summary_for(template) %></span>
                    <span style="font-size:10.5px;color:var(--color-ink-4);">Guardada el <%= helpers.qb_fmt_date_short(template.created_at) %></span>
                  </div>
                  <% if template.description.present? %>
                    <div style="font-size:11px;color:var(--color-ink-3);margin-top:2px;"><%= template.description %></div>
                  <% end %>
                  <div style="display:flex;flex-wrap:wrap;gap:4px;margin-top:8px;">
                    <% preview_names(template).each do |item_name| %>
                      <span style="font-size:11px;padding:2px 8px;background:var(--color-bg-sunken);border-radius:12px;color:var(--color-ink-3);"><%= item_name %></span>
                    <% end %>
                  </div>
                </div>
              </div>
            </label>
          <% end %>
        <% else %>
          <div style="border:1px dashed var(--color-line-2);border-radius:8px;padding:12px;font-size:11.5px;color:var(--color-ink-3);line-height:1.5;">
            Todavía no guardaste plantillas propias. Cargá las etapas de una obra y usá
            <strong style="color:var(--color-ink-2);">Guardar como plantilla</strong> para reutilizarlas en la próxima.
          </div>
        <% end %>
      </div>

      <%# Toggles. El hidden previo al checkbox garantiza que el "no" también
          viaje: sin él, destildar no manda nada y el server usa el default. %>
      <div style="margin-top:14px;padding:10px 12px;border:1px solid var(--color-line);border-radius:8px;display:flex;gap:18px;flex-wrap:wrap;background:var(--color-bg-sunken);">
        <label style="display:flex;align-items:center;gap:6px;font-size:12px;color:var(--color-ink-2);cursor:pointer;">
          <input type="hidden" name="apply_dates" value="0">
          <input type="checkbox" name="apply_dates" value="1" checked>
          Copiar fechas
          <span style="font-size:10.5px;color:var(--color-ink-4);">(desde el inicio de la obra)</span>
        </label>
        <label style="display:flex;align-items:center;gap:6px;font-size:12px;color:var(--color-ink-2);cursor:pointer;">
          <input type="hidden" name="apply_budgets" value="0">
          <input type="checkbox" name="apply_budgets" value="1">
          Copiar presupuestos
        </label>
      </div>

      <div style="display:flex;align-items:center;gap:8px;margin-top:14px;">
        <%= render Qb::BtnComponent.new('Aplicar plantilla', variant: :primary, icon: :layers, type: 'submit') %>
        <%= render Qb::BtnComponent.new('Cancelar', variant: :secondary, data: { action: 'click->qb--drawer#back' }) %>
        <div style="flex:1;"></div>
        <%= link_to 'Administrar plantillas', constructors_stage_templates_path,
                    style: 'font-size:11.5px;color:var(--color-ink-3);text-decoration:none;' %>
      </div>
    <% end %>
  <% end %>
</div>
