<%= form_with model: stage,
              url: form_url,
              method: form_method do |form| %>
  <%= form.hidden_field :parent_id, value: parent_field_value if parent_field_value.present? %>
  <% if stage.errors.any? %>
    <div class="qb-form-error" role="alert">
      <p style="font-weight:600;margin:0 0 4px;">No pudimos guardar la etapa:</p>
      <ul style="margin:0;padding-left:16px;">
        <% stage.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= render Qb::FormGroupComponent.new(title: 'Identidad') do %>
    <div class="qb-field">
      <%= form.label :name, "Nombre de la etapa", class: "qb-label" %>
      <%= form.text_field :name, **field_opts(:name) %>
    </div>

    <div class="qb-field" style="margin-bottom:0;">
      <%= form.label :description, "Descripción", class: "qb-label" %>
      <%= form.text_area :description, rows: 3, class: "qb-textarea" %>
      <p style="margin:0;font-size:11px;color:var(--color-ink-4);">Anotá los entregables o alcance clave de la etapa.</p>
    </div>
  <% end %>

  <%= render Qb::FormGroupComponent.new(title: 'Cronograma',
        footnote: "El fin debe ser posterior o igual al inicio. #{duration_hint}") do %>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
      <div class="qb-field" style="margin-bottom:0;">
        <%= form.label :start_date, "Fecha de inicio", class: "qb-label" %>
        <%= form.date_field :start_date, **field_opts(:start_date) %>
      </div>
      <div class="qb-field" style="margin-bottom:0;">
        <%= form.label :end_date, "Fecha de finalización", class: "qb-label" %>
        <%= form.date_field :end_date, **field_opts(:end_date) %>
      </div>
    </div>
  <% end %>

  <% if tracking_fields? %>
    <%# Avance, responsable y presupuesto: los tres los muestra el resto de la
        app (card, drawer, Gantt, CSV, curva S) y hasta ahora no había forma de
        editarlos salvo «Marcar completada», que fuerza 100. %>
    <%= render Qb::FormGroupComponent.new(title: 'Seguimiento') do %>
      <div style="display:grid;grid-template-columns:110px 1fr;gap:12px;">
        <div class="qb-field" style="margin-bottom:0;">
          <%= form.label :progress, "Avance (%)", class: "qb-label" %>
          <%= form.number_field :progress, in: 0..100, step: 1, **field_opts(:progress) %>
        </div>
        <div class="qb-field" style="margin-bottom:0;">
          <%= form.label :lead, "Responsable", class: "qb-label" %>
          <%= form.text_field :lead, placeholder: "Ej: Juan Pérez", **field_opts(:lead) %>
        </div>
      </div>

      <div style="margin:10px 0 12px;">
        <%= render Qb::BarComponent.new(value: progress_value, tone: progress_value >= 100 ? :ok : :accent, height: 6) %>
        <p style="margin:4px 0 0;font-size:11px;color:var(--color-ink-4);">Avance guardado: <%= progress_value %>%.</p>
      </div>

      <div class="qb-field" style="margin-bottom:0;">
        <%= form.label :budget_pesos, "Presupuesto de la etapa", class: "qb-label" %>
        <div style="position:relative;">
          <span class="qb-mono" style="position:absolute;left:10px;top:50%;transform:translateY(-50%);font-size:12px;color:var(--color-ink-4);">$</span>
          <%= form.text_field :budget_pesos, value: budget_pesos_value, class: "qb-input",
                inputmode: "decimal", placeholder: "0", style: "padding-left:22px;" %>
        </div>
        <p style="margin:0;font-size:11px;color:var(--color-ink-4);">En pesos. Se compara contra lo gastado en la curva S y en el detalle.</p>
      </div>
    <% end %>
  <% end %>

  <% if predecessor_candidates.any? %>
    <%= render Qb::FormGroupComponent.new(title: 'Dependencias',
          collapsible: true, open: dependencies_open?,
          footnote: 'La etapa no puede empezar antes de que termine su predecesora.') do %>
      <div class="qb-field" style="margin-bottom:0;">
        <%= form.label :predecessor_id, "Etapa predecesora", class: "qb-label" %>
        <%= form.select :predecessor_id,
                        predecessor_candidates,
                        { include_blank: "— ninguna —" },
                        class: "qb-select" %>
      </div>
    <% end %>
  <% end %>

  <div style="display:flex;align-items:center;gap:8px;margin-top:4px;padding-top:14px;border-top:1px solid var(--color-line);">
    <% if stage.persisted? %>
      <%= render Qb::BtnComponent.new('Eliminar etapa', variant: :danger, size: :sm,
            href: delete_href,
            data: { turbo_method: :delete,
                    turbo_frame: '_top',
                    turbo_confirm: '¿Eliminar la etapa y todas sus sub-etapas?' }) %>
    <% end %>
    <div style="flex:1;"></div>
    <% if in_drawer? %>
      <%= render Qb::BtnComponent.new('Cancelar', variant: :secondary, size: :md,
            data: { action: 'click->qb--drawer#close' }) %>
    <% else %>
      <%= render Qb::BtnComponent.new('Cancelar', variant: :secondary, size: :md,
            href: cancel_href, data: { turbo_frame: '_top' }) %>
    <% end %>
    <%= render Qb::BtnComponent.new(submit_label, variant: :primary, size: :md, type: 'submit') %>
  </div>
<% end %>
