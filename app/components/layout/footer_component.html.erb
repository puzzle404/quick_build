<footer class="bg-white border-t border-slate-200" aria-labelledby="footer-heading">
  <h2 id="footer-heading" class="sr-only">Footer</h2>
  <div class="mx-auto max-w-7xl px-6 pb-8 pt-16 sm:pt-24 lg:px-8 lg:pt-32">
    <div class="xl:grid xl:grid-cols-3 xl:gap-8">
      <div class="space-y-8">
        <div class="flex items-center gap-2">
          <div class="h-8 w-8 rounded bg-indigo-600 flex items-center justify-center text-white font-bold">Q</div>
          <span class="text-xl font-bold text-slate-900">Quick Build</span>
        </div>
        <p class="text-sm leading-6 text-slate-600">
          Simplificando la construcción para todos. Conectamos proyectos, personas y proveedores.
        </p>
      </div>
      <div class="mt-16 grid grid-cols-2 gap-8 xl:col-span-2 xl:mt-0">
        <div class="md:grid md:grid-cols-2 md:gap-8">
          <div>
            <h3 class="text-sm font-semibold leading-6 text-slate-900">Soluciones</h3>
            <ul role="list" class="mt-6 space-y-4">
              <li><%= link_to "Constructores", constructors_root_path, class: "text-sm leading-6 text-slate-600 hover:text-slate-900" %></li>
              <li><%= link_to "Compradores", products_path, class: "text-sm leading-6 text-slate-600 hover:text-slate-900" %></li>
            </ul>
          </div>
          <div class="mt-10 md:mt-0">
            <h3 class="text-sm font-semibold leading-6 text-slate-900">Producto</h3>
            <ul role="list" class="mt-6 space-y-4">
              <li><%= link_to "Características", root_path(anchor: "features"), class: "text-sm leading-6 text-slate-600 hover:text-slate-900" %></li>
              <li><%= link_to "Precios", precios_path, class: "text-sm leading-6 text-slate-600 hover:text-slate-900" %></li>
            </ul>
          </div>
        </div>
        <div class="md:grid md:grid-cols-2 md:gap-8">
          <div>
            <h3 class="text-sm font-semibold leading-6 text-slate-900">Compañía</h3>
            <ul role="list" class="mt-6 space-y-4">
              <li><%= link_to "Contacto", root_path(anchor: "contacto"), class: "text-sm leading-6 text-slate-600 hover:text-slate-900" %></li>
              <li><%= link_to "Crear cuenta", new_registration_path, class: "text-sm leading-6 text-slate-600 hover:text-slate-900" %></li>
            </ul>
          </div>
          <div class="mt-10 md:mt-0">
            <h3 class="text-sm font-semibold leading-6 text-slate-900">Legal</h3>
            <ul role="list" class="mt-6 space-y-4">
              <li><%= link_to "Privacidad", privacidad_path, class: "text-sm leading-6 text-slate-600 hover:text-slate-900" %></li>
              <li><%= link_to "Términos", terminos_path, class: "text-sm leading-6 text-slate-600 hover:text-slate-900" %></li>
            </ul>
          </div>
        </div>
      </div>
    </div>
    <div class="mt-16 border-t border-slate-900/10 pt-8 sm:mt-20 lg:mt-24">
      <p class="text-xs leading-5 text-slate-500">&copy; <%= Time.current.year %> Quick Build. Todos los derechos reservados.</p>
    </div>
  </div>
</footer>
