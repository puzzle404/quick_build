<% content_for :qb_crumbs, [{ label: 'Inicio' }, { label: 'Personas' }, { label: @person.full_name }].to_json %>
<% content_for :title, "#{@person.full_name} · Quick Build" %>

<%
  any_active = @assignments.any? { |a| a.status.to_s == 'active' }
  pct = @stats[:attendance_pct]
  attn_tone = pct.to_i >= 85 ? :ok : (pct.to_i >= 70 ? :warn : :muted)
  noted = @assignments.select { |a| a.notes.present? }
  edit_href = edit_constructors_person_path(@person)
%>

<div>
  <%# Header strip primero, KPIs después — mismo orden que blueprints/index y projects/show. %>
  <div style="padding:14px 20px;border-bottom:1px solid var(--color-line);display:flex;align-items:flex-end;gap:16px;">
    <div style="flex:1;display:flex;align-items:center;gap:12px;min-width:0;">
      <%= render Qb::AvatarComponent.new(name: @person.full_name, size: 36) %>
      <div style="min-width:0;">
        <div style="font-size:11px;font-family:var(--font-mono);color:var(--color-ink-3);text-transform:uppercase;letter-spacing:0.8px;">Personas · global</div>
        <h1 style="margin:3px 0 0;font-size:20px;font-weight:600;letter-spacing:-0.3px;"><%= @person.full_name %></h1>
        <div style="display:flex;align-items:center;gap:8px;margin-top:4px;flex-wrap:wrap;font-size:12px;color:var(--color-ink-3);">
          <%= render Qb::PillComponent.new(any_active ? 'Activa' : 'Inactiva', tone: any_active ? :ok : :muted, compact: true) %>
          <span><%= @person.role_title.presence || 'Sin rol especificado' %></span>
          <% if @person.phone.present? %>
            <%= link_to @person.phone, "tel:#{@person.phone}", class: 'qb-mono',
                  style: 'color:var(--color-accent);text-decoration:none;font-size:11px;' %>
          <% end %>
          <%= link_to '← Volver a personas', constructors_people_path,
                style: 'color:var(--color-accent);text-decoration:none;font-size:12px;' %>
        </div>
      </div>
    </div>
    <%= render Qb::BtnComponent.new('Editar datos', variant: :secondary, size: :sm, icon: :edit, href: edit_href,
          data: { turbo_frame: 'drawer', action: 'click->qb--drawer#open' }) %>
  </div>

  <%# KPI strip — consolidado entre obras. "Horas registradas" salió: hours está
      en NULL en el 100% de las asistencias, así que era una celda con guion fijo. %>
  <div style="display:grid;grid-template-columns:repeat(4, 1fr);border-bottom:1px solid var(--color-line);background:var(--color-bg-raised);">
    <%= render Qb::MetricCellComponent.new(
          label: 'Obras asignadas',
          value: @stats[:projects_count],
          hint: "#{@stats[:active_count]} #{@stats[:active_count] == 1 ? 'asignación activa' : 'asignaciones activas'}"
        ) %>
    <%= render Qb::MetricCellComponent.new(
          label: 'Asistencia · 30 días',
          value: pct ? "#{pct}%" : '—',
          hint: "sobre #{@stats[:business_days]} días hábiles",
          tone: attn_tone
        ) %>
    <%= render Qb::MetricCellComponent.new(
          label: 'Días trabajados',
          value: @stats[:attendance_days],
          hint: 'con marca este mes'
        ) %>
    <%= render Qb::MetricCellComponent.new(
          label: 'Tarifa',
          value: @stats[:hourly_rate_cents] ? qb_fmt_cents(@stats[:hourly_rate_cents]) : '—',
          hint: '$/hora · la más alta entre obras'
        ) %>
  </div>

  <div style="display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.4fr);gap:0;">
    <div style="border-right:1px solid var(--color-line);">
      <%# Datos de identidad — los campos vacíos ofrecen el link para cargarlos. %>
      <%= render Qb::SectionHeadComponent.new(title: 'Datos') do |c| %>
        <% c.with_right do %>
          <%= render Qb::BtnComponent.new('Editar', variant: :ghost, size: :xs, icon: :edit, href: edit_href,
                data: { turbo_frame: 'drawer', action: 'click->qb--drawer#open' }) %>
        <% end %>
      <% end %>
      <%= render Qb::DataGridComponent.new(items: [
            { label: 'Documento', value: @person.document_id.presence, mono: true, empty_href: edit_href, empty_label: 'Cargar documento' },
            { label: 'Teléfono', value: @person.phone.presence, mono: true, empty_href: edit_href, empty_label: 'Cargar teléfono' },
            { label: 'Rol principal', value: @person.role_title.presence },
            { label: 'Obras activas', value: "#{@stats[:active_count]} de #{@assignments.size}", mono: true }
          ]) %>

      <%# Nombre + teléfono es la clave que agrupa a la persona entre obras. %>
      <div style="padding:14px 20px;font-size:11px;color:var(--color-ink-4);line-height:1.5;">
        Nombre y teléfono son la clave que consolida a la persona entre obras.
        El rol, la vigencia y la tarifa se editan dentro de cada obra.
      </div>
    </div>

    <div>
      <%# Asignaciones por obra %>
      <%= render Qb::SectionHeadComponent.new(title: "Asignaciones por obra · #{@assignments.size}",
            subtitle: 'Rol, vigencia y tarifa se editan dentro de cada obra.') %>
      <table class="qb-table">
        <thead>
          <tr style="background:var(--color-bg-raised);">
            <th>Obra</th>
            <th>Rol</th>
            <th>Vigencia</th>
            <th style="text-align:right;">Días · mes</th>
            <th style="text-align:right;">Tarifa</th>
            <th style="text-align:right;">Estado</th>
            <th style="width:32px;"></th>
          </tr>
        </thead>
        <tbody>
          <% @assignments.each do |a| %>
            <% active = a.status.to_s == 'active' %>
            <% days = @days_by_assignment[a.id].to_i %>
            <tr>
              <td>
                <%= link_to constructors_project_path(a.project), style: 'text-decoration:none;color:var(--color-ink);font-weight:500;' do %>
                  <span class="qb-mono" style="font-size:10px;color:var(--color-ink-3);"><%= a.project.decorate.code %></span>
                  <span style="display:block;"><%= a.project.name %></span>
                <% end %>
              </td>
              <td style="color:var(--color-ink-2);"><%= a.role_title.presence || '—' %></td>
              <td class="qb-mono" style="color:var(--color-ink-2);font-size:11px;">
                <%= a.start_date ? qb_fmt_date_short(a.start_date) : '—' %><% if a.end_date.present? %> · <%= qb_fmt_date_short(a.end_date) %><% end %>
              </td>
              <td class="qb-mono qb-tnum" style="text-align:right;color:<%= days.positive? ? 'var(--color-ink)' : 'var(--color-ink-4)' %>;"><%= days.positive? ? days : '—' %></td>
              <td class="qb-mono" style="text-align:right;color:var(--color-ink-2);font-size:11px;"><%= a.hourly_rate_cents ? qb_fmt_cents(a.hourly_rate_cents) : '—' %></td>
              <td style="text-align:right;">
                <%= render Qb::PillComponent.new(active ? 'Activa' : 'Inactiva', tone: active ? :ok : :muted, compact: true) %>
              </td>
              <td style="text-align:right;">
                <%= link_to constructors_project_person_path(a.project, a), title: 'Ver ficha en esa obra',
                      style: 'color:var(--color-ink-4);text-decoration:none;display:inline-flex;' do %>
                  <%= render Qb::IconComponent.new(name: :'chevron-right', size: 14) %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>

      <%# Asistencia reciente consolidada. La columna Horas salió (0 registros con horas). %>
      <%= render Qb::SectionHeadComponent.new(title: 'Asistencia reciente') %>
      <% if @attendances.any? %>
        <table class="qb-table">
          <thead>
            <tr style="background:var(--color-bg-raised);">
              <th>Fecha</th>
              <th>Obra</th>
              <th style="text-align:right;">Origen</th>
            </tr>
          </thead>
          <tbody>
            <% @attendances.each do |att| %>
              <tr>
                <td class="qb-mono" style="font-size:11px;"><%= qb_fmt_date_short(att.occurred_at.to_date) %></td>
                <td style="color:var(--color-ink-2);"><%= att.project_person.project.name %></td>
                <td style="text-align:right;">
                  <%= render Qb::PillComponent.new(att.source.presence&.humanize || 'Manual', tone: :muted, compact: true) %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <div style="margin:14px 20px;padding:28px;text-align:center;color:var(--color-ink-4);font-size:13px;border:1px dashed var(--color-line);border-radius:var(--radius);">
          Sin asistencias registradas. Se marcan desde cada obra («Dar presente»).
        </div>
      <% end %>

      <%# Notas por asignación — sólo si existen: antes quedaba un SectionHead con «Sin notas». %>
      <% if noted.any? %>
        <%= render Qb::SectionHeadComponent.new(title: "Notas · #{noted.size}") %>
        <div style="padding:14px 20px;">
          <% noted.each do |a| %>
            <div style="margin-bottom:10px;">
              <div style="font-size:10px;font-family:var(--font-mono);color:var(--color-ink-3);text-transform:uppercase;letter-spacing:0.5px;"><%= a.project.name %></div>
              <p style="margin:4px 0 0;font-size:13px;color:var(--color-ink-2);line-height:1.5;white-space:pre-line;"><%= a.notes %></p>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>
