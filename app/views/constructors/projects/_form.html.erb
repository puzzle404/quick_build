<%= form_with model: [:constructors, project] do |f| %>
  <%# Cada card es una sección: su título usa .qb-form-section-title (sans,
      13px, semibold) para no confundirse con las etiquetas de los campos. %>
  <section class="qb-card" style="margin-bottom:16px;">
    <h3 class="qb-form-section-title" style="margin-bottom:4px;">Información general</h3>
    <p style="font-size:12px;color:var(--color-ink-3);margin-bottom:14px;">Estos datos aparecen en los tableros y reportes compartidos con tu equipo.</p>
    <div style="display:grid;grid-template-columns:1fr;gap:12px;">
      <div class="qb-field" style="margin-bottom:0;">
        <%= f.label :name, "Nombre", class: "qb-label" %>
        <%= f.text_field :name, class: "qb-input" %>
      </div>
      <%# Cliente y presupuesto sólo se cargaban en el alta: la tarjeta "Datos
          de la obra" mandaba a editar datos que este form no tenía. %>
      <div class="qb-field" style="margin-bottom:0;">
        <%= f.label :client, "Cliente", class: "qb-label" %>
        <%= f.text_field :client, placeholder: "Razón social", class: "qb-input" %>
      </div>
      <div class="qb-field" style="margin-bottom:0;">
        <%= f.label :description, "Descripción", class: "qb-label" %>
        <%= f.text_area :description, rows: 3, class: "qb-input", style: "resize:vertical;" %>
      </div>
    </div>
  </section>

  <section class="qb-card" style="margin-bottom:16px;">
    <h3 class="qb-form-section-title" style="margin-bottom:4px;">Ubicación de la obra</h3>
    <p style="font-size:12px;color:var(--color-ink-3);margin-bottom:12px;">El domicilio es el que se comparte; el mapa marca dónde queda la obra.</p>
    <%= render "constructors/projects/location_fields", f: f, map_height: 320 %>
  </section>

  <section class="qb-card" style="margin-bottom:16px;">
    <h3 class="qb-form-section-title" style="margin-bottom:4px;">Plazo y presupuesto</h3>
    <p style="font-size:12px;color:var(--color-ink-3);margin-bottom:14px;">Estos valores alimentan la curva S y el tablero de hitos.</p>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
      <div class="qb-field" style="margin-bottom:0;">
        <%= f.label :start_date, "Fecha de inicio", class: "qb-label" %>
        <%= f.date_field :start_date, class: "qb-input" %>
      </div>
      <div class="qb-field" style="margin-bottom:0;">
        <%= f.label :end_date, "Fecha de entrega", class: "qb-label" %>
        <%= f.date_field :end_date, class: "qb-input" %>
      </div>
      <div class="qb-field" style="margin-bottom:0;grid-column:span 2;">
        <%= f.label :status, "Estado", class: "qb-label" %>
        <%= f.select :status,
                     Project.status_options,
                     {},
                     class: "qb-select" %>
      </div>
      <div style="grid-column:span 2;">
        <%= render "constructors/projects/budget_fields", f: f %>
      </div>
    </div>
  </section>

  <section class="qb-card" style="margin-bottom:16px;border-style:dashed;">
    <h3 class="qb-form-section-title" style="margin-bottom:4px;">Documentación de soporte</h3>
    <p style="font-size:12px;color:var(--color-ink-3);margin-bottom:14px;">
      Adjunta planos, fotos o reportes relevantes. Puedes seleccionar múltiples archivos a la vez.
    </p>

    <div class="qb-field">
      <p class="qb-label">Imágenes del proyecto</p>
      <p style="font-size:11px;color:var(--color-ink-4);">Formatos recomendados: JPG o PNG (máx. 25 MB c/u)</p>
      <%= render Qb::FileFieldComponent.new(form: f, method: :images,
                                            trigger_label: "Elegir imágenes",
                                            multiple: true, accept: "image/*", direct_upload: true) %>
    </div>

    <div class="qb-field" style="margin-bottom:0;">
      <p class="qb-label">Documentos (PDF)</p>
      <p style="font-size:11px;color:var(--color-ink-4);">Adjunta planos, contratos o reportes en PDF (máx. 25 MB c/u)</p>
      <%= render Qb::FileFieldComponent.new(form: f, method: :document_files,
                                            trigger_label: "Elegir documentos",
                                            multiple: true, accept: ".pdf,application/pdf", direct_upload: true) %>
    </div>
  </section>

  <div class="qb-form-actions">
    <%= render Qb::BtnComponent.new(
          project.persisted? ? "Actualizar obra" : "Crear obra",
          variant: :primary,
          type: 'submit'
        ) %>
  </div>
<% end %>
