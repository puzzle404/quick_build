<%# Campos de la obra, únicos para crear y editar (drawer y página completa):
    antes la edición tenía otro diseño (tarjetas, otro orden, adjuntos) y no
    se parecía al alta ni al resto de los forms (feedback 21/10). Secciones
    con Qb::FormGroupComponent, igual que etapas y personas. Las fotos y los
    documentos se suben desde sus pestañas (drawer de subida).
    Locals: f (form builder), for_create (bool), map_height (px, default 220). %>
<% for_create = local_assigns.fetch(:for_create, false) %>
<%= render Qb::FormGroupComponent.new(title: "Datos de la obra") do %>
  <div class="qb-field">
    <%= f.label :name, "Nombre del proyecto", class: "qb-label" %>
    <%= f.text_field :name, required: true, placeholder: 'Ej. Torre Palermo · Edificio Aurora', class: "qb-input" %>
  </div>
  <div class="qb-field">
    <%= f.label :client, "Cliente", class: "qb-label" %>
    <%= f.text_field :client, placeholder: 'Razón social', class: "qb-input" %>
  </div>
  <div class="qb-field" style="margin-bottom:0;">
    <%= f.label :description, "Descripción", class: "qb-label" %>
    <%= f.text_area :description, rows: 3, placeholder: 'Alcance de la obra, particularidades, notas para el equipo…', class: "qb-textarea" %>
  </div>
<% end %>

<%= render Qb::FormGroupComponent.new(title: "Plazo y presupuesto") do %>
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:14px;">
    <div class="qb-field" style="margin-bottom:0;">
      <%= f.label :start_date, "Fecha de inicio", class: "qb-label" %>
      <%= f.date_field :start_date, class: "qb-input" %>
    </div>
    <div class="qb-field" style="margin-bottom:0;">
      <%= f.label :end_date, "Fecha de entrega", class: "qb-label" %>
      <%= f.date_field :end_date, class: "qb-input" %>
    </div>
  </div>
  <%= render "constructors/projects/budget_fields", f: f %>
  <div class="qb-field" style="margin-bottom:0;">
    <% if for_create %>
      <%= f.label :status, "Estado inicial", class: "qb-label" %>
      <%= f.select :status, Project.status_options(for_create: true), { selected: f.object.status.presence || 'planned' }, class: "qb-select" %>
    <% else %>
      <%= f.label :status, "Estado", class: "qb-label" %>
      <%= f.select :status, Project.status_options, {}, class: "qb-select" %>
    <% end %>
  </div>
<% end %>

<%= render Qb::FormGroupComponent.new(title: "Ubicación de la obra") do %>
  <%= render "constructors/projects/location_fields", f: f, map_height: local_assigns.fetch(:map_height, 220) %>
<% end %>
