<% decorated_project = @project.decorated? ? @project : @project.decorate %>
<%# Correr/borrar análisis de IA es editor de obra en adelante — el mismo
    permiso que pide blueprints/ai_analyses#create/#destroy. %>
<% can_run_ai = policy(@project).manage_content? %>
<%= render 'constructors/projects/section_tabs', project: @project, current: :blueprints %>

<%# Header strip %>
<div style="padding:14px 20px;border-bottom:1px solid var(--color-line);display:flex;align-items:flex-end;gap:16px;">
  <div style="flex:1;">
    <div style="font-size:11px;font-family:var(--font-mono);color:var(--color-ink-3);text-transform:uppercase;letter-spacing:0.8px;"><%= decorated_project.code %> · Planos · IA</div>
    <h2 style="margin:3px 0 0;font-size:18px;font-weight:600;letter-spacing:-0.3px;">Análisis IA — <%= @blueprint.name.presence || "Plano ##{@blueprint.id}" %></h2>
    <div style="font-size:12px;color:var(--color-ink-3);margin-top:2px;">
      <%= @analyses.size %> análisis realizados
      · <%= link_to '← Volver al plano', constructors_project_blueprints_path(@project, selected: @blueprint.id), style: 'color:var(--color-accent);text-decoration:none;font-size:12px;' %>
    </div>
  </div>
  <% if can_run_ai %>
    <%= render Qb::BtnComponent.new('Nuevo análisis', variant: :primary, size: :sm, icon: :plus,
                                    href: constructors_project_blueprint_ai_analyses_path(@project.id, @blueprint.id),
                                    data: { turbo_method: :post }) %>
  <% end %>
</div>

<%# Historial — filas full bleed separadas por 1px %>
<% if @analyses.any? %>
  <div>
    <% @analyses.each do |analysis| %>
      <%
        pill_tone = case analysis.status
        when 'completed' then :ok
        when 'processing', 'queued' then :info
        when 'failed' then :bad
        else :muted
        end
        pill_label = case analysis.status
        when 'completed' then 'Completado'
        when 'processing' then 'Procesando...'
        when 'queued' then 'En cola'
        when 'failed' then 'Fallido'
        else analysis.status
        end
      %>
      <div style="padding:14px 20px;border-bottom:1px solid var(--color-line);display:flex;align-items:flex-start;gap:16px;">
        <div style="flex:1;min-width:0;">
          <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;">
            <%= render Qb::PillComponent.new(pill_label, tone: pill_tone) %>
            <% if analysis.applied? %>
              <%= render Qb::PillComponent.new('✓ Aplicado', tone: :accent) %>
            <% end %>
            <span style="font-size:11px;font-family:var(--font-mono);color:var(--color-ink-3);">
              hace <%= time_ago_in_words(analysis.created_at) %>
            </span>
          </div>

          <% if analysis.completed? %>
            <p style="margin:6px 0 0;font-size:13px;color:var(--color-ink);">Análisis completado exitosamente</p>
          <% elsif analysis.failed? %>
            <p style="margin:6px 0 0;font-size:13px;color:var(--color-bad);"><%= analysis.error_message&.truncate(150) || "Error desconocido" %></p>
          <% elsif analysis.processing? %>
            <p style="margin:6px 0 0;font-size:13px;color:var(--color-info);">Analizando plano con IA...</p>
          <% else %>
            <p style="margin:6px 0 0;font-size:13px;color:var(--color-ink-2);">En espera de procesamiento</p>
          <% end %>
        </div>

        <div style="display:flex;align-items:center;gap:8px;flex-shrink:0;">
          <% if analysis.completed? %>
            <%= render Qb::BtnComponent.new('Ver resultados', variant: :secondary, size: :sm,
                                            href: constructors_project_blueprint_ai_analysis_path(@project.id, @blueprint.id, analysis.id)) %>
          <% elsif analysis.processing? || analysis.status == 'queued' %>
            <%= render Qb::BtnComponent.new('Ver estado', variant: :secondary, size: :sm,
                                            href: constructors_project_blueprint_ai_analysis_path(@project.id, @blueprint.id, analysis.id)) %>
          <% end %>

          <% if can_run_ai %>
            <%= render Qb::BtnComponent.new(variant: :danger, size: :sm, icon: :trash,
                                            href: constructors_project_blueprint_ai_analysis_path(@project.id, @blueprint.id, analysis.id),
                                            aria_label: 'Eliminar análisis',
                                            data: { turbo_method: :delete, turbo_confirm: "¿Eliminar este análisis?" }) %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <div style="padding:60px;margin:16px;text-align:center;color:var(--color-ink-4);font-size:13px;border:1px dashed var(--color-line);border-radius:10px;">
    <%= render Qb::IconComponent.new(name: :blueprint, size: 32, style: 'margin-bottom:8px;opacity:0.5;') %>
    <div>No hay análisis todavía.</div>
    <% if can_run_ai %>
      <div style="font-size:11px;color:var(--color-ink-4);margin-top:6px;">Comenzá creando tu primer análisis con IA para este plano.</div>
      <div style="margin-top:16px;">
        <%= render Qb::BtnComponent.new('Crear primer análisis', variant: :primary, size: :sm,
                                        href: constructors_project_blueprint_ai_analyses_path(@project.id, @blueprint.id),
                                        data: { turbo_method: :post }) %>
      </div>
    <% end %>
  </div>
<% end %>
