<%# Subir plano.
    - turbo_frame_request (botón "Subir plano" con data-turbo-frame="project_modal"):
      modal QB OS dentro del frame; qb--modal la auto-abre. Mismo approach que
      Materiales / Etapas / Personas.
    - full page (acceso directo o re-render con errores de validación):
      shell de secciones QB OS + formulario centrado. %>
<% if turbo_frame_request? %>
  <%= turbo_frame_tag 'project_modal' do %>
    <div data-controller="qb--modal" data-qb--modal-open-on-connect-value="true">
      <%= render Constructors::Projects::Blueprints::UploadModalComponent.new(
            project: @project, blueprint: @blueprint) %>
    </div>
  <% end %>
<% else %>
  <%= render 'constructors/projects/section_tabs', project: @project, current: :blueprints %>

  <%# Header strip %>
  <div style="padding:14px 20px;border-bottom:1px solid var(--color-line);display:flex;align-items:flex-end;gap:16px;">
    <div style="flex:1;min-width:0;">
      <div style="font-size:11px;font-family:var(--font-mono);color:var(--color-ink-3);text-transform:uppercase;letter-spacing:0.8px;"><%= @project.decorate.code %> · Planos</div>
      <h2 style="margin:3px 0 0;font-size:18px;font-weight:600;letter-spacing:-0.3px;">Subir plano</h2>
      <div style="font-size:12px;color:var(--color-ink-3);margin-top:2px;">
        Cargá un plano arquitectónico en formato JPG o PNG · <%= link_to '← Volver a planos', constructors_project_blueprints_path(@project), style: 'color:var(--color-accent);text-decoration:none;font-size:12px;' %>
      </div>
    </div>
  </div>

  <%# Formulario %>
  <div style="padding:24px 20px;border-bottom:1px solid var(--color-line);">
    <div style="max-width:560px;margin:0 auto;">
      <%= form_with model: @blueprint, url: constructors_project_blueprints_path(@project), html: { multipart: true } do |f| %>

        <% if @blueprint.errors.any? %>
          <div class="qb-form-error">
            <p style="font-weight:600;margin:0 0 4px;">Hay <%= pluralize(@blueprint.errors.count, "error") %> que impiden guardar el plano:</p>
            <ul style="margin:0;padding-left:16px;">
              <% @blueprint.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div class="qb-field">
          <%= f.label :name, "Nombre del plano", class: "qb-label" %>
          <%= f.text_field :name, placeholder: "Ej: Planta baja - Arquitectura", class: "qb-input" %>
        </div>

        <div class="qb-field">
          <%= f.label :description, "Descripción (opcional)", class: "qb-label" %>
          <%= f.text_area :description, rows: 3, placeholder: "Ej: Plano de arquitectura con distribución de ambientes", class: "qb-textarea" %>
        </div>

        <div class="qb-field">
          <%= f.label :file, "Archivo del plano", class: "qb-label" %>
          <%= f.file_field :file,
                accept: "image/jpeg,image/png,image/jpg",
                direct_upload: true,
                style: "display:block;font-size:12px;color:var(--color-ink-2);width:100%;padding:10px;border:1px dashed var(--color-line-2);border-radius:var(--radius);background:var(--color-bg-sunken);" %>
          <p style="font-size:11px;color:var(--color-ink-4);margin-top:4px;">Formatos aceptados: JPG, PNG. Tamaño máximo: 10MB</p>
        </div>

        <div class="qb-form-actions">
          <%= render Qb::BtnComponent.new("Cancelar", variant: :secondary, size: :sm, href: constructors_project_blueprints_path(@project)) %>
          <%= render Qb::BtnComponent.new("Subir plano", variant: :primary, size: :sm, type: 'submit') %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
