<% content_for :title, "Editar lista · #{@project.name}" %>
<%
  back = constructors_project_material_list_path(@project, @material_list)
  status_options = [
    ['Borrador', 'draft'],
    ['En revisión', 'ready_for_review'],
    ['Aprobada', 'approved']
  ]
  source_options = [
    ['Manual', 'manual'],
    ['Importar PDF', 'pdf_upload'],
    ['Importar Excel', 'excel_upload']
  ]
%>

<%= render Qb::Mobile::NavBarComponent.new(title: "Editar lista", back: true, back_href: back) %>

<div style="padding: 4px 20px 12px;">
  <h1 style="margin: 0; font-size: 22px; font-weight: 700; letter-spacing: -0.4px;"><%= "#{@material_list.display_number} #{@material_list.name}".strip %></h1>
  <p style="margin: 4px 0 0; font-size: 13.5px; color: var(--color-ink-3); line-height: 1.4;">
    Actualizá los datos para mantener la lista al día.
  </p>
</div>

<%= form_with model: @material_list, url: constructors_project_material_list_path(@project, @material_list), method: :patch, local: true, html: { multipart: true, style: "padding: 0 16px;" } do |f| %>
  <% if @material_list.errors.any? %>
    <div role="alert" style="margin-bottom:14px;padding:10px 12px;border-radius:10px;background:color-mix(in oklab, var(--color-bad) 12%, transparent);color:var(--color-bad);font-size:13px;">
      <%= @material_list.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <%= render Qb::Mobile::FormGroupComponent.new(title: "Datos") do %>
    <%= render Qb::Mobile::FormRowComponent.new(
          label: "Nombre", name: "material_list[name]",
          value: @material_list.name,
          placeholder: "Ej: Hierros · Estructura",
          required: true) %>
    <%= render Qb::Mobile::FormRowComponent.new(
          label: "Notas", name: "material_list[notes]",
          value: @material_list.notes,
          textarea: true,
          placeholder: "Contexto, especificaciones técnicas, etc.") %>
    <%= render Qb::Mobile::FormRowComponent.new(
          label: "Etapa", name: "material_list[project_stage_id]", select: true,
          value: @material_list.project_stage_id,
          options: [['— Sin etapa —', '']] + (@project_stages || []).map { |s| [s.name, s.id] }) %>
  <% end %>

  <%= render Qb::Mobile::FormGroupComponent.new(title: "Estado y origen") do %>
    <%= render Qb::Mobile::FormRowComponent.new(
          label: "Estado", name: "material_list[status]", select: true,
          value: @material_list.status,
          options: status_options) %>
    <%= render Qb::Mobile::FormRowComponent.new(
          label: "Origen", name: "material_list[source_type]", select: true,
          value: @material_list.source_type,
          options: source_options) %>
  <% end %>

  <%= render Qb::Mobile::FormGroupComponent.new(title: "Archivo de referencia (opcional)", footnote: "PDF, Excel u otros archivos que quieras conservar junto a la lista.") do %>
    <div class="m-frow">
      <label class="m-frow-label">Archivo</label>
      <%= f.file_field :source_file, accept: "application/pdf,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", class: "m-frow-input" %>
    </div>
  <% end %>

  <div style="display:flex;gap:10px;padding-bottom:24px;">
    <%= link_to "Cancelar", back,
          class: "m-btn m-btn--secondary m-btn--md",
          style: "flex:1;text-decoration:none;" %>
    <%= f.submit "Guardar cambios", class: "m-btn m-btn--md", style: "flex:1.4;" %>
  </div>
<% end %>
