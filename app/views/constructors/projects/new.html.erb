<%# Nueva obra. Mismo form que la edición (_form → _project_fields).
    - turbo_frame_request (botón "Nuevo proyecto"): drawer global.
    - página completa (acceso directo): el mismo form centrado.
    Formulario de un solo paso: la plantilla de etapas se aplica desde la obra
    ya creada ("Aplicar plantilla" en el header del proyecto). %>
<% if turbo_frame_request? %>
  <% content_for(:drawer) do %>
    <%= render(Qb::DrawerComponent.new(eyebrow: "Nuevo proyecto", title: "Crear una obra", size: :lg)) do %>
      <%= render "form", project: @project, in_drawer: true %>
    <% end %>
  <% end %>
<% else %>
  <% content_for :qb_crumbs, [{label: 'Inicio'}, {label: 'Proyectos'}, {label: 'Nuevo'}].to_json %>

  <%# Header strip %>
  <div style="padding:14px 20px;border-bottom:1px solid var(--color-line);">
    <div style="font-size:11px;font-family:var(--font-mono);color:var(--color-ink-3);text-transform:uppercase;letter-spacing:0.8px;">Nuevo proyecto</div>
    <h2 style="margin:3px 0 0;font-size:18px;font-weight:600;letter-spacing:-0.3px;">Crear una obra</h2>
  </div>

  <div style="padding:24px 20px;">
    <div style="max-width:560px;margin:0 auto;">
      <%= render "form", project: @project, map_height: 260 %>
    </div>
  </div>
<% end %>
