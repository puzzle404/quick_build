<%
  active_count = @people.count { |p| p.status.to_s == 'active' }
  on_leave_count = @people.count { |p| p.status.to_s == 'inactive' }

  # Personas con presente ya registrado hoy — la fila muestra pill en vez del
  # botón "Presente" (evita duplicar asistencias con doble clic).
  present_today_ids = PersonAttendance.where(project_person_id: @people.map(&:id))
                                      .where(occurred_at: Date.current.all_day)
                                      .distinct.pluck(:project_person_id)

  # Alta/baja de personas y gestión de miembros: admin de obra en adelante
  # (ProjectPersonPolicy / ProjectMembershipPolicy). Marcar el presente, en
  # cambio, es editor — por eso son dos permisos distintos.
  can_manage_team = policy(@project).manage_team?
  can_mark_attendance = policy(@project).manage_content?
%>

<div>
  <%= render 'constructors/projects/section_tabs', project: @project, current: :team %>

  <%# KPI strip %>
  <div style="display:grid;grid-template-columns:repeat(4, 1fr);border-bottom:1px solid var(--color-line);background:var(--color-bg-raised);">
    <%= render Qb::MetricCellComponent.new(label: 'Personas asignadas', value: @people.size, hint: "#{active_count} activas") %>
    <%= render Qb::MetricCellComponent.new(label: 'En licencia', value: on_leave_count, hint: 'inactivas hoy') %>
    <% avg_pct = @team_stats[:avg_attendance_pct] %>
    <%= render Qb::MetricCellComponent.new(
          label: 'Asistencia promedio',
          value: avg_pct ? "#{avg_pct}%" : '—',
          hint: avg_pct ? "últimos #{@team_stats[:window_days]} días" : 'sin datos todavía',
          tone: avg_pct.to_i >= 85 ? :ok : (avg_pct.to_i >= 70 ? :warn : :muted)
        ) %>
    <%
      labor_cents = @team_stats[:labor_cost_cents]
      hours       = @team_stats[:hours_logged]
      planned     = @team_stats[:planned_hours]
      hint = if hours && planned
               "#{hours} hs · #{((hours.to_f / planned) * 100).round}% plan"
             elsif hours
               "#{hours} hs registradas"
             else
               'sin tarifas u horas cargadas'
             end
    %>
    <%= render Qb::MetricCellComponent.new(
          label: 'Costo MO',
          value: labor_cents ? qb_fmt_cents(labor_cents) : '—',
          hint: hint
        ) %>
  </div>

  <%# Toolbar %>
  <div style="display:flex;align-items:center;padding:10px 16px;gap:8px;border-bottom:1px solid var(--color-line);background:var(--color-bg-raised);">
    <form action="<%= constructors_project_people_path(@project) %>" method="get" style="display:flex;align-items:center;gap:8px;flex:1;">
      <div style="display:flex;align-items:center;gap:6px;padding:0 10px;height:28px;background:var(--color-bg);border:1px solid var(--color-line);border-radius:5px;width:280px;">
        <%= render Qb::IconComponent.new(name: :search, size: 13, style: 'color:var(--color-ink-4)') %>
        <input type="search" name="q" value="<%= @query %>" placeholder="Buscar personas…"
               style="flex:1;border:none;outline:none;background:transparent;font-size:12px;color:var(--color-ink);">
      </div>
    </form>
    <div style="flex:1;"></div>
    <%# La asistencia se marca por fila (botón "Presente") — sin botón global. %>
    <%# Abre el modal de alta vía Turbo Frame (project_modal) — mismo approach que stages. %>
    <% if can_manage_team %>
      <%= render Qb::BtnComponent.new('Invitar persona', variant: :primary, size: :xs, icon: :plus,
            href: new_constructors_project_person_path(@project), data: { turbo_frame: 'project_modal' }) %>
    <% end %>
  </div>

  <%# Table — el tbody siempre existe (id people_rows) para poder hacer append
      por turbo_stream al crear; la fila vacía se elimina en el create. %>
  <table style="width:100%;border-collapse:collapse;font-size:12px;">
    <thead>
      <tr style="background:var(--color-bg-raised);">
        <% ['Persona', 'Rol', 'Documento', 'Inicio / Fin', 'Estado', ''].each_with_index do |h, i| %>
          <th style="padding:8px 12px;text-align:<%= i == 4 ? 'right' : 'left' %>;border-bottom:1px solid var(--color-line);font-size:10px;font-family:var(--font-mono);color:var(--color-ink-3);font-weight:500;letter-spacing:0.5px;text-transform:uppercase;"><%= h %></th>
        <% end %>
      </tr>
    </thead>
    <tbody id="people_rows">
      <% @people.each do |person| %>
        <%= render 'constructors/projects/people/person_row', person: person, project: @project,
                    present_today: present_today_ids.include?(person.id),
                    can_mark_attendance: can_mark_attendance %>
      <% end %>
      <% if @people.empty? %>
        <tr id="people_empty_row">
          <td colspan="6" style="padding:48px 12px;text-align:center;color:var(--color-ink-4);font-size:13px;">
            <%= render Qb::IconComponent.new(name: :people, size: 28, style: 'margin-bottom:8px;opacity:0.5;') %>
            <% if @query.present? %>
              <div>Sin resultados para «<strong style="color:var(--color-ink-2);"><%= @query %></strong>».</div>
              <div style="font-size:11px;color:var(--color-ink-4);margin-top:6px;">
                <%= link_to 'Limpiar búsqueda', constructors_project_people_path(@project), style: 'color:var(--color-accent);text-decoration:none;' %>
              </div>
            <% elsif can_manage_team %>
              <div>Todavía no sumaste personas a esta obra.</div>
            <% else %>
              <div>Esta obra todavía no tiene personas asignadas.</div>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <%# Accesos a la obra: usuarios de la plataforma + su rol. Vive acá porque
      es la pestaña "Equipo" y era el único lugar donde ya se invitaba gente.
      "Personas" (arriba) es quién trabaja en la obra; esto es quién entra al
      sistema a verla. %>
  <div style="border-top:1px solid var(--color-line-2);margin-top:8px;">
    <%= render Constructors::Projects::Overview::MembersPanelComponent.new(project: @project) %>
  </div>
</div>

<%# Destino del modal "Invitar persona" (Turbo Frame). %>
<%= turbo_frame_tag "project_modal" %>
