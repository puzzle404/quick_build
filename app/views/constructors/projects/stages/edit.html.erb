<%# Editar etapa.
    - turbo_frame_request (lápiz/Editar con data-turbo-frame="project_modal"):
      modal QB OS dentro del frame project_modal (auto-abre dentro de #project_modal).
    - full page (acceso directo): shell QB OS (section_tabs + header strip) con el form centrado.
    Las dos ramas muestran el mismo contexto (código, nombre, estado) porque dentro
    de la modal no había forma de saber qué etapa se estaba editando. %>
<% stage = @stage.decorate %>

<%# Pills de contexto, compartidas por las dos ramas. %>
<% context_pills = capture do %>
  <%= render Qb::PillComponent.new(stage.status_label, tone: stage.status_tone, compact: true) %>
  <% if stage.overdue? %>
    <%= render Qb::PillComponent.new('Atrasada', tone: :bad, compact: true) %>
  <% end %>
  <% if stage.days_total %>
    <span class="qb-mono" style="font-size:11px;color:var(--color-ink-4);"><%= stage.days_total + 1 %> días</span>
  <% end %>
<% end %>

<% if turbo_frame_request? %>
  <%= turbo_frame_tag "project_modal" do %>
    <div data-controller="qb--modal" data-qb--modal-open-on-connect-value="true">
    <div data-qb--modal-target="dialog" role="dialog" aria-modal="true"
         class="hidden"
         data-action="click->qb--modal#backdrop keydown@window->qb--modal#keydown"
         style="display:flex;position:fixed;inset:0;z-index:60;background:rgba(0,0,0,0.45);align-items:center;justify-content:center;">
      <div data-qb--modal-target="panel"
           style="position:relative;width:640px;max-height:86vh;background:var(--color-bg);border:1px solid var(--color-line);border-radius:10px;overflow:hidden;display:flex;flex-direction:column;box-shadow:0 20px 50px -10px rgba(0,0,0,0.4);">

        <div style="padding:14px 18px;border-bottom:1px solid var(--color-line);display:flex;justify-content:space-between;align-items:flex-start;gap:12px;">
          <div style="min-width:0;">
            <div style="font-size:10px;font-family:var(--font-mono);text-transform:uppercase;letter-spacing:0.7px;color:var(--color-accent);margin-bottom:4px;">
              Planificación · Etapa <%= stage.code %>
            </div>
            <h3 style="margin:0;font-size:15px;font-weight:600;color:var(--color-ink);"><%= @stage.name %></h3>
            <div style="display:flex;align-items:center;gap:6px;margin-top:6px;flex-wrap:wrap;">
              <%= context_pills %>
            </div>
          </div>
          <button type="button" data-action="click->qb--modal#close" aria-label="Cerrar"
                  style="background:transparent;border:none;color:var(--color-ink-3);cursor:pointer;flex-shrink:0;">
            <%= render Qb::IconComponent.new(name: :x, size: 16) %>
          </button>
        </div>

        <div style="flex:1;overflow:auto;padding:18px;">
          <div class="qb-card" style="padding:16px;">
            <%= render Constructors::Projects::Stages::StageFormComponent.new(project: @project, stage: @stage, in_modal: true) %>
          </div>
        </div>
      </div>
    </div>
    </div>
  <% end %>
<% else %>
  <% project = @project.decorate %>
  <%= render 'constructors/projects/section_tabs', project: project, current: :stages %>

  <%# Header strip %>
  <div style="padding:14px 20px;border-bottom:1px solid var(--color-line);display:flex;align-items:flex-end;gap:16px;">
    <div style="flex:1;min-width:0;">
      <div style="font-size:11px;font-family:var(--font-mono);color:var(--color-ink-3);text-transform:uppercase;letter-spacing:0.8px;">
        <%= project.code %> · Planificación · Etapa <%= stage.code %>
      </div>
      <h2 style="margin:3px 0 0;font-size:18px;font-weight:600;letter-spacing:-0.3px;"><%= @stage.name %></h2>
      <div style="display:flex;align-items:center;gap:6px;margin-top:6px;flex-wrap:wrap;">
        <%= context_pills %>
        <%= link_to '← Volver a la etapa', constructors_project_stage_path(@project, @stage),
              style: 'color:var(--color-accent);text-decoration:none;font-size:12px;' %>
      </div>
    </div>
  </div>

  <div style="padding:28px 20px;">
    <div style="max-width:620px;margin:0 auto;">
      <%= render Constructors::Projects::Stages::StageFormComponent.new(project: @project, stage: @stage) %>
    </div>
  </div>
<% end %>
