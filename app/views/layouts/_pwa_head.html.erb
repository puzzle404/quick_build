<%# Tags PWA compartidos por los layouts. viewport y apple-mobile-web-app-capable
    ya viven en cada layout. theme-color sigue el mismo mecanismo que data-theme en
    constructor/mobile (current_user&.theme, default "graphite"): el tema "night" es
    opt-in por usuario y no sigue prefers-color-scheme. Los hex son el token
    --color-bg de cada tema en app/assets/tailwind/application.css:
    graphite = oklch(98.5% 0.004 90) ≈ #fbfaf8, night = oklch(18% 0.015 250) ≈ #0d1218. %>
<% pwa_theme = current_user&.theme || "graphite" %>
<%= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>
<meta name="theme-color" content="<%= pwa_theme == "night" ? "#0d1218" : "#fbfaf8" %>">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<meta name="apple-mobile-web-app-title" content="QuickBuild">
<link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192">
<link rel="icon" href="/icon-512.png" type="image/png" sizes="512x512">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
