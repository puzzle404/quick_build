<!DOCTYPE html>
<html lang="es"
      data-theme="<%= current_user&.theme || 'graphite' %>"
      data-density="<%= current_user&.density || 'cozy' %>"
      data-accent="<%= current_user&.accent || 'cobalt' %>"
      data-layout="sidebar">
  <head>
    <title><%= content_for(:title) || "Quick Build · OS" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700&family=Geist+Mono:wght@400;500;600&display=swap" rel="stylesheet">

    <%= render "layouts/pwa_head" %>

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <%= render "layouts/ui_kit_head" %>
    <% if (maps_key = qb_google_maps_api_key).present? %><meta name="google-maps-api-key" content="<%= maps_key %>"><% end %>
  </head>

  <body class="qb-os" <%= "data-hotwire-native" if hotwire_native_app? %>
        data-controller="qb--keyboard qb--tweaks qb--mobile-detect qb--drawer qb--loading"
        data-qb--drawer-global-value="true"
        data-qb--tweaks-persist-value="<%= current_user.present? %>"
        data-qb--tweaks-initial-value='<%= { theme: current_user&.theme || "graphite", accent: current_user&.accent || "cobalt", density: current_user&.density || "cozy", layout: "sidebar" }.to_json %>'>
    <div style="display:flex;min-height:100vh;">
      <%= render Qb::Layout::SidebarComponent.new(
            current: current_qb_section || :dashboard,
            user: current_user,
            project: current_qb_project,
            project_sub: current_qb_project_sub,
            # El contador y los accesos rápidos cuentan LO MISMO que lista
            # /constructors/projects (propias + donde soy miembro). Con
            # `owned_projects` el sidebar decía "0" mientras la pantalla de
            # al lado mostraba las obras donde el usuario es miembro.
            project_count: (current_user.accessible_projects.count rescue nil),
            pinned_projects: (current_user.accessible_projects.order(updated_at: :desc).limit(4).map { ProjectDecorator.new(_1) } rescue []),
            company_name: (current_user.try(:company)&.name rescue nil)
          ) %>

      <main style="flex:1;min-width:0;display:flex;flex-direction:column;">
        <%
          # Topbar values come from DashboardKpis so the chip stays consistent
          # with the dashboard hero strip. Reuse @kpis when set by the
          # dashboard controller; compute lazily otherwise.
          # Mismo conjunto que el dashboard (que ya lista obras accesibles): si
          # acá se contaran sólo las propias, el chip de la topbar contradiría
          # los KPIs de la pantalla de abajo.
          qb_topbar_kpis = (defined?(@kpis) && @kpis.is_a?(Hash)) ? @kpis : (DashboardKpis.new(current_user.accessible_projects.includes(:project_stages).map { ProjectDecorator.new(_1) }).call rescue {})
          qb_people_on_site = qb_topbar_kpis[:people_on_site].to_i
          qb_people_on_site = nil if qb_people_on_site.zero?
          qb_has_alerts = qb_topbar_kpis[:has_alerts] == true
        %>
        <%= render Qb::Layout::TopbarComponent.new(
              crumbs: (content_for(:qb_crumbs).present? ? JSON.parse(CGI.unescapeHTML(content_for(:qb_crumbs).to_s), symbolize_names: true) : [{label: 'Inicio'}]),
              user: current_user,
              people_on_site: qb_people_on_site,
              has_alerts: qb_has_alerts
            ) %>

        <%= render Qb::ToastStackComponent.new(notice: notice, alert: alert) %>

        <%# Página lenta (qb--loading): Bloques sobre el área de contenido. %>
        <div class="qb-page-loader" aria-hidden="true" data-turbo-permanent id="qb_page_loader">
          <%= render Qb::SpinnerComponent.new(variant: :blocks, size: 32, label: "Cargando…") %>
        </div>

        <div style="flex:1;min-width:0;">
          <%= yield %>
        </div>
      </main>
    </div>

    <%# Chrome mobile: bottom tab bar + sheet "Más". En Hotwire Native lo provee
        la app nativa, así que no se renderiza. %>
    <% unless hotwire_native_app? %>
      <div data-controller="qb--bottom-sheet"
           data-action="keydown@window->qb--bottom-sheet#closeOnEsc">
        <%= render Qb::Layout::BottomNavComponent.new(
              current: current_qb_section || :dashboard,
              project: current_qb_project,
              project_sub: current_qb_project_sub
            ) %>
        <%= render Qb::Layout::MobileSheetComponent.new(
              project: current_qb_project,
              project_sub: current_qb_project_sub,
              user: current_user,
              company_name: (current_user.try(:company)&.name rescue nil)
            ) %>
      </div>
    <% end %>

    <%# Panel lateral único: reemplaza a project_modal + stage_detail. Vive acá
        (no en cada vista) para que triggers globales como "+ Nuevo proyecto"
        del sidebar funcionen sin importar en qué pantalla esté el usuario.
        Las vistas nunca declaran su propio <turbo-frame id="drawer">: sólo
        proveen contenido con content_for(:drawer), o el layout terminaría
        emitiendo un id duplicado. %>
    <div>
      <%# Permanente (id fijo): Turbo lo conserva entre renders y qb--drawer
          decide en turbo:before-render si sigue abierto (refresh ajeno) o se
          cierra (navegación, o guardado del propio drawer). %>
      <div id="qb_drawer_shell" data-turbo-permanent class="qb-drawer-shell" role="dialog" aria-modal="true"
           data-qb--drawer-target="dialog"
           data-action="click->qb--drawer#backdrop keydown@window->qb--drawer#keydown">
        <div class="qb-drawer-backdrop"></div>
        <%# Esqueleto que qb--drawer clona en el frame si un GET tarda. %>
        <template data-qb--drawer-target="skeleton"><%= render Qb::DrawerSkeletonComponent.new %></template>
        <%= turbo_frame_tag "drawer", data: { "qb--drawer-target": "frame" } do %>
          <%= yield :drawer %>
        <% end %>
      </div>
    </div>

    <%= render Qb::Layout::CmdPaletteComponent.new %>
    <%= render Qb::Layout::TweaksPanelComponent.new %>
  </body>
</html>
