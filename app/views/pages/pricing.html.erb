<% content_for :title, "Precios · Quick Build" %>

<div class="bg-white">
  <div class="mx-auto max-w-7xl px-6 py-16 sm:py-24 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-base font-semibold leading-7 text-indigo-600">Precios</p>
      <h1 class="mt-2 text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">
        Un plan para cada etapa de tu empresa
      </h1>
      <p class="mt-6 text-lg leading-8 text-slate-600">
        Empezá gratis y pasate a Pro cuando tu operación lo necesite. Sin permanencia: cancelás cuando quieras.
      </p>
    </div>

    <div class="mx-auto mt-16 grid max-w-lg grid-cols-1 gap-8 lg:max-w-5xl lg:grid-cols-3">
      <!-- Plan Gratis -->
      <div class="flex flex-col rounded-3xl p-8 ring-1 ring-slate-200">
        <h2 class="text-lg font-semibold leading-8 text-slate-900">Gratis</h2>
        <p class="mt-2 text-sm leading-6 text-slate-600">Para probar Quick Build con tu primera obra.</p>
        <p class="mt-6 flex items-baseline gap-x-1">
          <span class="text-4xl font-bold tracking-tight text-slate-900">$0</span>
          <span class="text-sm font-semibold leading-6 text-slate-600">/mes</span>
        </p>
        <ul role="list" class="mt-8 space-y-3 text-sm leading-6 text-slate-600">
          <% [
            "1 obra activa",
            "Etapas, gastos y notas ilimitados",
            "Hasta 1 GB de documentos y planos",
            "3 personas de obra con asistencia",
            "Listas de materiales manuales"
          ].each do |feature| %>
            <li class="flex gap-x-3">
              <svg class="h-6 w-5 flex-none text-indigo-600" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" />
              </svg>
              <%= feature %>
            </li>
          <% end %>
        </ul>
        <%= link_to "Comenzar gratis", new_registration_path, class: "mt-8 block rounded-xl px-3.5 py-2.5 text-center text-sm font-semibold text-indigo-600 ring-1 ring-inset ring-indigo-200 transition-colors hover:ring-indigo-300 hover:bg-indigo-50" %>
      </div>

      <!-- Plan Pro (destacado) -->
      <div class="relative flex flex-col rounded-3xl p-8 ring-2 ring-indigo-600 shadow-xl shadow-indigo-500/10">
        <div class="absolute -top-4 left-1/2 -translate-x-1/2 rounded-full bg-indigo-600 px-3 py-1 text-xs font-semibold text-white">
          Más elegido
        </div>
        <h2 class="text-lg font-semibold leading-8 text-indigo-600">Pro</h2>
        <p class="mt-2 text-sm leading-6 text-slate-600">Para constructores que gestionan varias obras a la vez.</p>
        <p class="mt-6 flex items-baseline gap-x-1">
          <span class="text-4xl font-bold tracking-tight text-slate-900">$29.999</span>
          <span class="text-sm font-semibold leading-6 text-slate-600">/mes por usuario</span>
        </p>
        <ul role="list" class="mt-8 space-y-3 text-sm leading-6 text-slate-600">
          <% [
            "Obras ilimitadas",
            "Documentos y planos ilimitados",
            "Análisis de planos con IA",
            "Listas de materiales generadas con IA",
            "Equipo de obra y asistencias sin límite",
            "Curva S y reportes de avance",
            "Soporte prioritario"
          ].each do |feature| %>
            <li class="flex gap-x-3">
              <svg class="h-6 w-5 flex-none text-indigo-600" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" />
              </svg>
              <%= feature %>
            </li>
          <% end %>
        </ul>
        <%= link_to "Probar 14 días gratis", new_registration_path, class: "mt-8 block rounded-xl bg-indigo-600 px-3.5 py-2.5 text-center text-sm font-semibold text-white shadow-lg shadow-indigo-500/20 transition-all hover:bg-indigo-500" %>
      </div>

      <!-- Plan Empresa -->
      <div class="flex flex-col rounded-3xl p-8 ring-1 ring-slate-200">
        <h2 class="text-lg font-semibold leading-8 text-slate-900">Empresa</h2>
        <p class="mt-2 text-sm leading-6 text-slate-600">Para constructoras y estudios con equipos grandes.</p>
        <p class="mt-6 flex items-baseline gap-x-1">
          <span class="text-4xl font-bold tracking-tight text-slate-900">A medida</span>
        </p>
        <ul role="list" class="mt-8 space-y-3 text-sm leading-6 text-slate-600">
          <% [
            "Todo lo del plan Pro",
            "Usuarios y roles a medida",
            "Onboarding asistido del equipo",
            "Acuerdo de nivel de servicio (SLA)",
            "Facturación centralizada"
          ].each do |feature| %>
            <li class="flex gap-x-3">
              <svg class="h-6 w-5 flex-none text-indigo-600" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" />
              </svg>
              <%= feature %>
            </li>
          <% end %>
        </ul>
        <%= link_to "Contactanos", root_path(anchor: "contacto"), class: "mt-8 block rounded-xl px-3.5 py-2.5 text-center text-sm font-semibold text-indigo-600 ring-1 ring-inset ring-indigo-200 transition-colors hover:ring-indigo-300 hover:bg-indigo-50" %>
      </div>
    </div>

    <p class="mx-auto mt-12 max-w-2xl text-center text-sm leading-6 text-slate-500">
      Precios en pesos argentinos, IVA incluido. El plan Pro incluye 14 días de prueba sin tarjeta de crédito.
    </p>
  </div>
</div>

<%= render Layout::FooterComponent.new %>
